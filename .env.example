# --- Grist ---
GRIST_HOST=https://votre-grist.example.fr
RH_SYNC_API_KEY=remplacer_par_la_cle_du_compte_technique
DEMANDES_DOC_ID=remplacer_par_id_document_demandes
COCKPIT_DOC_ID=remplacer_par_id_document_cockpit
SYNC_INTERVAL_SECONDS=60

# Liens optionnels insérés dans les emails
PORTAL_URL=
COCKPIT_URL=

# --- Notifications SMTP ---
# false = aucune connexion SMTP / aucun email
SMTP_ENABLED=false
SMTP_HOST=smtp.example.fr
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=rh@example.fr
SMTP_FROM_NAME=RH - Demandes
SMTP_TIMEOUT_SECONDS=20

# Etat persistant anti-doublon des notifications
STATE_FILE=/data/state.json
# false recommandé : au premier démarrage, initialise les empreintes sans notifier les anciennes demandes
NOTIFY_EXISTING_ON_FIRST_RUN=false
